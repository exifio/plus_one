# Integration test 전용 Supabase 프로젝트 설정 템플릿 (로컬 전용, Git 커밋 금지)
#
# 사용법:
#   1. Supabase Dashboard에서 non-production 용도의 프로젝트를 생성한다.
#   2. 이 파일을 .env.test.local 로 복사하고 아래 값을 채운다.
#   3. 프로젝트 DB에 migrations를 적용한다 (supabase db push --db-url ...).
#   4. npm run test:integration 실행.
#
# 주의: 이 harness는 로컬/프로덕션 URL로의 fallback을 하지 않는다.
#       SUPABASE_TEST_PROJECT=non-production 은 안전 장치이므로 반드시 함께 설정한다.
#
# integration test가 남긴 데이터 정리:
#   npm run cleanup:integration

SUPABASE_TEST_URL=https://<project-ref>.supabase.co
SUPABASE_TEST_ANON_KEY=<publishable / anon key>
SUPABASE_TEST_SERVICE_ROLE_KEY=<secret / service_role key>
SUPABASE_TEST_PROJECT=non-production

# non-production Supabase Auth 관리자 계정 검증용 (실제 값은 .env.test.local에만 입력)
# SUPABASE_TEST_ADMIN_EMAIL=<admin email>
# SUPABASE_TEST_ADMIN_PASSWORD=<admin password>

# migration 적용에 필요한 DB 접속 (테스트 실행에는 불필요, supabase db push 에만 사용)
# SUPABASE_TEST_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
